# ── Supabase (required) ──────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Internal service auth (required, min 32 chars) ──────────────────────────
INTERNAL_WORKSPACE_SECRET=generate-with-openssl-rand-hex-32
CRON_SECRET=generate-with-openssl-rand-hex-32

# ── SearXNG ──────────────────────────────────────────────────────────────────
SEARXNG_SECRET_KEY=generate-with-openssl-rand-hex-32

# ── Cloudflare (free tier — for custom hostnames) ───────────────────────────
CLOUDFLARE_ZONE_ID=your-zone-id
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token-with-zone-dns-edit

# ── Google (free APIs) ───────────────────────────────────────────────────────
# Service account JSON (base64-encoded) for GSC Indexing API + Site Verification
GOOGLE_SERVICE_ACCOUNT_JSON=base64-encoded-service-account-json
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-oauth-client-secret

# ── IndexNow (Bing/DuckDuckGo/ChatGPT Search — free) ───────────────────────
# Comma-separated key:hostname pairs
INDEXNOW_KEYS=abc123:talentxcel.in,def456:chatr.chat,ghi789:nutytales.com

# ── Social accounts (Patchright stealth — no paid API) ──────────────────────
# FB_ACCOUNT_POOL, IG_ACCOUNT_POOL, YT_CHANNELS, LI_ACCOUNTS, X_ACCOUNTS
# Format: JSON array stored as base64-encoded string
FB_ACCOUNT_POOL=base64-encoded-json-array
IG_ACCOUNT_POOL=base64-encoded-json-array
YT_CHANNELS=base64-encoded-json-array
LI_ACCOUNTS=base64-encoded-json-array
X_ACCOUNTS=base64-encoded-json-array

# ── Media factory ────────────────────────────────────────────────────────────
EDGE_TTS_VOICE=en-IN-NeerjaNeural
MEDIA_OUTPUT_DIR=/media

# ── Ollama (local LLM) ───────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

# ── Cron overrides ───────────────────────────────────────────────────────────
TREND_BRAIN_CRON=0 */2 * * *
