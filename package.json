{
  "name": "autonomous-growth-os",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Autonomous Growth OS — AI-agentic cross-channel traffic acquisition platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present && node scripts/copy-dist.js",
    "dev": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:unit": "npm run test:unit --workspace=apps/api",
    "test:integration": "npm run test:integration --workspace=apps/api",
    "test:e2e": "npm run test:e2e --workspace=apps/api",
    "db:migrate": "npm run db:migrate --workspace=apps/api",
    "db:seed:dev": "npm run db:seed:dev --workspace=apps/api",
    "safety:check": "node scripts/safety-check.js",
    "test:ollama": "tsx scripts/test-ollama.ts",
    "ollama:serve": "node scripts/ollama-service.ts",
    "autodm:listen": "tsx scripts/run-autodm-listener.ts --daemon",
    "orchestrator:run": "tsx scripts/autonomous-orchestrator.ts --now",
    "sitemaps:verify": "tsx scripts/submit-gsc-sitemaps.ts --list",
    "worker:crawler": "npm run worker:crawler --workspace=apps/api"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "@types/node": "^22.0.0",
    "prettier": "^3.3.3",
    "eslint": "^9.11.0",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0"
  }
}
