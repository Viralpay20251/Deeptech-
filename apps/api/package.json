{
  "name": "@growth-os/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "node --loader tsx scripts/migrate.ts",
    "db:rollback": "node --loader tsx scripts/rollback.ts",
    "db:seed:dev": "NODE_ENV=development node --loader tsx src/db/seeds/dev-seed.ts"
  },
  "dependencies": {
    "express": "^4.21.1",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "pg": "^8.12.0",
    "node-postgres": "^0.6.0",
    "zod": "^3.23.8",
    "uuid": "^10.0.0",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3",
    "openai": "^4.67.0",
    "@anthropic-ai/sdk": "^0.30.1",
    "axios": "^1.7.7",
    "xml2js": "^0.6.2",
    "node-html-parser": "^6.1.13",
    "sanitize-html": "^2.13.1",
    "robots-parser": "^3.0.1",
    "micromatch": "^4.0.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "@types/sanitize-html": "^2.13.0",
    "@types/micromatch": "^4.0.9",
    "@types/xml2js": "^0.4.14",
    "tsx": "^4.19.1",
    "vitest": "^2.1.2",
    "@vitest/coverage-v8": "^2.1.2",
    "typescript": "^5.5.4",
    "@growth-os/shared-types": "*"
  }
}
