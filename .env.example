# ============================================================
# AUTONOMOUS GROWTH OS — Environment Variables Template
# ============================================================
# Copy this file to .env (never commit .env).
# All secrets must be supplied via environment or a secrets manager.
# No secret value belongs in this file — only variable names and descriptions.
# ============================================================

# ----- APPLICATION -----
NODE_ENV=development
APP_NAME=autonomous-growth-os
APP_VERSION=0.1.0
PORT=3001
LOG_LEVEL=info
# FEATURE_PAID_MEDIA=false          # Paid media connectors — disabled by default
# FEATURE_SAAS_ONBOARDING=false     # External tenant creation — disabled until proof gates pass
# FEATURE_LEVEL3_AUTONOMY=false     # Bounded autonomy — disabled until reliability gates pass

# ----- DATABASE (PostgreSQL) -----
DATABASE_URL=                       # postgresql://user:password@host:5432/growth_os_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SSL=false                  # Set to true in production

# ----- INTERNAL WORKSPACE -----
# The single internal workspace used during the proof phase.
# Set to a fixed UUID for the internal validation workspace.
INTERNAL_WORKSPACE_ID=             # e.g. 00000000-0000-0000-0000-000000000001
INTERNAL_WORKSPACE_SECRET=         # Random secret for internal-only API calls

# ----- JWT / SESSION -----
JWT_SECRET=                        # Minimum 64-char random secret
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
SESSION_SECRET=                    # Minimum 64-char random secret

# ----- MODEL GATEWAY (AI providers) -----
# The OS uses a model gateway abstraction — swap providers without code changes.
MODEL_PROVIDER=openai              # openai | anthropic | google | azure-openai
OPENAI_API_KEY=                    # Required if MODEL_PROVIDER=openai
ANTHROPIC_API_KEY=                 # Required if MODEL_PROVIDER=anthropic
GOOGLE_AI_API_KEY=                 # Required if MODEL_PROVIDER=google
AZURE_OPENAI_ENDPOINT=             # Required if MODEL_PROVIDER=azure-openai
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Model budget caps per run (USD)
MODEL_BUDGET_PER_TASK_USD=0.50
MODEL_BUDGET_DAILY_USD=10.00

# ----- GOOGLE SEARCH CONSOLE -----
# Status: AWAITING_CREDENTIALS — connector implemented, OAuth pending
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REDIRECT_URI=http://localhost:3001/connectors/gsc/callback

# ----- BING WEBMASTER TOOLS -----
# Status: AWAITING_CREDENTIALS
BING_WMT_API_KEY=

# ----- LINKEDIN -----
# Status: AWAITING_CREDENTIALS — OAuth app approval required
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3001/connectors/linkedin/callback

# ----- META (Facebook / Instagram) -----
# Status: AWAITING_CREDENTIALS — Business app review required
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3001/connectors/meta/callback

# ----- YOUTUBE / GOOGLE -----
# Status: AWAITING_CREDENTIALS
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3001/connectors/youtube/callback

# ----- REDDIT -----
# Status: AWAITING_CREDENTIALS
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=http://localhost:3001/connectors/reddit/callback

# ----- X (TWITTER) -----
# Status: AWAITING_CREDENTIALS — API v2 elevated access required
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:3001/connectors/x/callback

# ----- GA4 / GOOGLE ANALYTICS -----
# Status: AWAITING_CREDENTIALS
GA4_CLIENT_ID=
GA4_CLIENT_SECRET=
GA4_REDIRECT_URI=http://localhost:3001/connectors/ga4/callback

# ----- OBJECT STORAGE (S3-compatible) -----
STORAGE_PROVIDER=local             # local | s3 | gcs
STORAGE_BUCKET=growth-os-assets
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=                  # for non-AWS S3-compatible (Supabase, R2, etc.)

# ----- QUEUE / WORKFLOW ENGINE -----
QUEUE_DRIVER=memory                # memory (dev) | pg-boss (production with Postgres)
QUEUE_MAX_CONCURRENCY=5
QUEUE_RETRY_LIMIT=3

# ----- EMAIL / NOTIFICATIONS (internal ops only) -----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@growth-os.internal
ALERT_EMAIL=                       # Internal ops alert recipient

# ----- PROTECTED SYSTEMS REGISTRY -----
# These values are used to ensure the OS NEVER touches production systems.
# Add known production project IDs / DB connection strings for safety checks.
PROTECTED_DB_HOSTS=                # comma-separated host names of protected production DBs
PROTECTED_PROJECT_IDS=             # comma-separated IDs (Supabase/Vercel/etc.) to block

# ----- OBSERVABILITY -----
OTEL_EXPORTER_OTLP_ENDPOINT=       # optional OpenTelemetry endpoint
SENTRY_DSN=                        # optional Sentry error tracking (OS project only)
